# Copy this file to .env and replace the placeholder values.
# Never commit .env.

SALVIUM_APP_ROOT=/mnt/sharedrive/apps/salvium
SALVIUM_DATA_ROOT=/mnt/sharedrive/apps/salvium/data
P2POOL_WALLET=replace-with-your-public-salvium-wallet-address

PUID=1000
PGID=1000

# The Docker server should have a reserved/static LAN address.
# LAN services are bound only to this address; public peer ports use IPv4.
LAN_BIND_IP=192.168.1.54
PUBLIC_BIND_IP=0.0.0.0
PRIVATE_P2POOL_BIND_IP=192.168.1.54

# DHCP clients are authorized by trusted subnet, not individual address.
TRUSTED_LAN_CIDRS=192.168.1.0/24
PRIVATE_P2POOL_CIDRS=192.168.1.0/24
# Optional comma-separated Docker/VPN subnets that need restricted RPC.
RESTRICTED_RPC_EXTRA_CIDRS=

SALVIUMD_IMAGE=salviumd:local
P2POOL_IMAGE=p2pool-salvium:local
STATS_IMAGE=salvium-stats:local
FIREWALL_IMAGE=salvium-firewall:local
ALPINE_IMAGE=alpine:3.20
DOCKER_CLI_IMAGE=docker:cli

SALVIUM_P2P_PORT=19080
SALVIUM_RESTRICTED_RPC_PORT=19089
P2POOL_STRATUM_PORT=3333
P2POOL_PRIVATE_P2P_PORT=38888
P2POOL_PUBLIC_P2P_PORT=38889
STATS_PORT=3000

# Reviewed statistics source revision. Change only after reviewing a new commit.
STATS_SOURCE_COMMIT=a0fed9e186fa85d16eefdaf62bd6dbecadb629af

SALVIUM_NODE_NETWORK=salvium_node
SALVIUM_PRIVILEGED_RPC_NETWORK=salvium_privileged_rpc
SALVIUM_STATS_NETWORK=salvium_stats
SALVIUM_MANAGEMENT_NETWORK=salvium_management
SALVIUM_NODE_SUBNET=172.30.190.0/28
SALVIUM_PRIVILEGED_RPC_SUBNET=172.30.190.16/28
SALVIUM_STATS_SUBNET=172.30.190.32/28
SALVIUM_MANAGEMENT_SUBNET=172.30.190.48/28

SALVIUMD_CPUS=2.0
SALVIUMD_MEMORY_LIMIT=4192M
P2POOL_CPUS=2.0
P2POOL_MEMORY_LIMIT=4192M

UPDATE_CHECK_INTERVAL=21600
WATCHDOG_CHECK_INTERVAL=60
WATCHDOG_FAIL_AFTER=900
WATCHDOG_RECOVER_AFTER=1800
WATCHDOG_DWELL=3600
WATCHDOG_TRIAL_WINDOW=300
WATCHDOG_HEIGHT_STALL=600
WATCHDOG_STALE_STATS=300
WATCHDOG_PROBE_MIN_OK=2
WATCHDOG_PRIVATE_PROBE_MIN_OK=1
